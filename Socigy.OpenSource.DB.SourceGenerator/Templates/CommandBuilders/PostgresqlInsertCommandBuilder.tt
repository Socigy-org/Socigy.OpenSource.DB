    public class PostgresqlInsertCommandBuilder<T> : SqlCommandBuilder<PostgresqlInsertCommandBuilder<T>>
        where T : IDbTable
    {
#if NET6_0_OR_GREATER
        protected System.Data.Common.DbBatch? _Batch;

        /// <summary>
        /// Specifies the batch to use for subsequent database operations.
        /// </summary>
        /// <remarks>If <paramref name="batch"/> is <see langword="null"/>, the method attempts to create a new
        /// batch from the current connection or transaction. The batch is used to group multiple database commands for
        /// execution as a single unit.</remarks>
        /// <param name="batch">The <see cref="DbBatch"/> instance to associate with the operation, or <see langword="null"/> to create a new
        /// batch from the current connection or transaction.</param>
        /// <returns>The current instance with the specified batch applied.</returns>
        /// <exception cref="ArgumentNullException">Thrown if <paramref name="batch"/> is <see langword="null"/> and neither a connection nor a transaction is
        /// specified.</exception>
        /// <exception cref="InvalidOperationException">Thrown if <paramref name="batch"/> is <see langword="null"/> and the provided transaction does not have an
        /// associated <see cref="DbConnection"/>.</exception>
        public PostgresqlInsertCommandBuilder<T> WithBatch(DbBatch? batch)
        {
            if (batch == null)
            {
                if (_Connection == null && _Transaction == null)
                    throw new ArgumentNullException(nameof(batch), "If batch is null, either connection or transaction must be specified!");

                _Batch = _Connection?.CreateBatch() ?? _Transaction!.Connection?.CreateBatch() ?? throw new InvalidOperationException("The provided transaction has no DbConnection from which a DbBatch could be created");
                _Batch.Transaction = _Transaction;
            }
            else
                _Batch = batch;

            return this;
        }

        /// <summary>
        /// Adds a new command to the current batch operation.
        /// </summary>
        /// <remarks>This method should be called only after a batch has been initialized using
        /// WithBatch(). Attempting to add to a batch without initialization will result in an exception.</remarks>
        /// <exception cref="InvalidOperationException">Thrown if no batch has been provided. Call WithBatch() before invoking this method.</exception>
        public void AddToBatch()
        {
            if (_Batch == null)
                throw new InvalidOperationException("Cannot add to batch when no DbBatch was provided. Please call WithBatch() first.");

            var batchCommand = _Batch.CreateBatchCommand();
            _Batch.BatchCommands.Add(batchCommand);
        }

        /// <summary>
        /// Adds a new command to the current database batch asynchronously.
        /// </summary>
        /// <remarks>This method should be called only after a batch has been initialized using
        /// WithBatch(). It is typically used to accumulate multiple commands for execution as a single batch
        /// operation.</remarks>
        /// <returns>A task that represents the asynchronous operation.</returns>
        /// <exception cref="InvalidOperationException">Thrown if no database batch has been provided. Call WithBatch() before invoking this method.</exception>
        public async Task AddToBatchAsync()
        {
            if (_Batch == null)
                throw new InvalidOperationException("Cannot add to batch when no DbBatch was provided. Please call WithBatch() first.");

            var batchCommand = _Batch.CreateBatchCommand();
            _Batch.BatchCommands.Add(batchCommand);
        }
#endif

        private readonly T _TableRow;
        private Dictionary<string, ColumnInfo>? _ColumnInfo;

        private HashSet<string>? _SelectedDbColumns;
        private HashSet<string>? _ExcludedDbColumns;
        private HashSet<string>? _IncludedAutoFields;
        private bool _ForceAllFields;
        private bool _PropagateValues;
        private bool _ExcludeAutoFields;

        public PostgresqlInsertCommandBuilder(T rowInstance, Dictionary<string, ColumnInfo>? columnInfo = null)
        {
            _TableRow = rowInstance;
            _ColumnInfo = columnInfo;
        }

        /// <summary>
        /// Sets the column metadata to be used for building the PostgreSQL insert command.
        /// </summary>
        /// <param name="columnInfo">A dictionary mapping column names to their associated metadata. Cannot be null.</param>
        /// <returns>The current instance of <see cref="PostgresqlInsertCommandBuilder{T}"/> with updated column information.</returns>
        public PostgresqlInsertCommandBuilder<T> WithColumnInfo(Dictionary<string, ColumnInfo> columnInfo)
        {
            _ColumnInfo = columnInfo;
            return this;
        }

        /// <summary>
        /// Forces ALL columns (including auto-increment ones) to be included in the INSERT statement.
        /// </summary>
        public PostgresqlInsertCommandBuilder<T> WithAllFields()
        {
            if (_SelectedDbColumns != null)
                throw new InvalidOperationException("Cannot combine WithAllFields() with WithFields().");
            if (_ExcludeAutoFields)
                throw new InvalidOperationException("Cannot combine WithAllFields() with ExcludeAutoFields().");

            _ForceAllFields = true;
            return this;
        }

        /// <summary>
        /// Specifies which fields to include in the INSERT statement.
        /// Auto-increment columns not listed here are excluded.
        /// </summary>
        public PostgresqlInsertCommandBuilder<T> WithFields(Expression<Func<T, object?[]>> select)
        {
            if (_ForceAllFields)
                throw new InvalidOperationException("Cannot combine WithFields() with WithAllFields().");
            if (_ExcludedDbColumns != null)
                throw new InvalidOperationException("Cannot combine WithFields() with ExcludeFields().");

            _SelectedDbColumns = ExtractDbColumnNames(select);
            return this;
        }

        /// <summary>
        /// AOT-safe overload of <see cref="WithFields(Expression{Func{T, object[]}})"/> naming the fields by string
        /// (a property name such as <c>nameof(Row.Name)</c>, or a DB column name) instead of an <c>Expression</c>
        /// selector — the expression form forces <c>Expression.NewArrayInit</c> (<c>[RequiresDynamicCode]</c>) at the
        /// call site and cannot be used under NativeAOT.
        /// </summary>
        public PostgresqlInsertCommandBuilder<T> WithFields(params string[] select)
        {
            if (_ForceAllFields)
                throw new InvalidOperationException("Cannot combine WithFields() with WithAllFields().");
            if (_ExcludedDbColumns != null)
                throw new InvalidOperationException("Cannot combine WithFields() with ExcludeFields().");

            _SelectedDbColumns = global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFieldsResolver.MapDbColumnNames(select, _TableRow);
            return this;
        }

        /// <summary>
        /// Excludes the specified fields from the INSERT statement.
        /// Auto-increment columns are also excluded unless <see cref="WithAllFields"/> is called.
        /// </summary>
        public PostgresqlInsertCommandBuilder<T> ExcludeFields(Expression<Func<T, object?[]>> except)
        {
            if (_SelectedDbColumns != null)
                throw new InvalidOperationException("Cannot combine ExcludeFields() with WithFields().");

            _ExcludedDbColumns = ExtractDbColumnNames(except);
            return this;
        }

        /// <summary>AOT-safe overload of <see cref="ExcludeFields(Expression{Func{T, object[]}})"/> naming the fields by string.</summary>
        public PostgresqlInsertCommandBuilder<T> ExcludeFields(params string[] except)
        {
            if (_SelectedDbColumns != null)
                throw new InvalidOperationException("Cannot combine ExcludeFields() with WithFields().");

            _ExcludedDbColumns = global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFieldsResolver.MapDbColumnNames(except, _TableRow);
            return this;
        }

        /// <summary>
        /// After INSERT, reads back all DB-generated values (auto-increment, defaults) and writes them
        /// back to the instance's properties via <c>RETURNING *</c>.
        /// Combine with <see cref="ExcludeAutoFields"/> to let the DB generate those values.
        /// </summary>
        public PostgresqlInsertCommandBuilder<T> WithValuePropagation()
        {
            _PropagateValues = true;
            return this;
        }

        /// <summary>
        /// Excludes auto-increment columns and DB-default columns from the INSERT statement so the
        /// database can generate or apply their values.
        /// Combine with <see cref="WithValuePropagation"/> to read those values back after insert.
        /// </summary>
        public PostgresqlInsertCommandBuilder<T> ExcludeAutoFields()
        {
            if (_ForceAllFields)
                throw new InvalidOperationException("Cannot combine ExcludeAutoFields() with WithAllFields().");
            if (_IncludedAutoFields != null)
                throw new InvalidOperationException("ExcludeAutoFields(include) has already been called. Use one form or the other.");
            _ExcludeAutoFields = true;
            return this;
        }

        /// <summary>
        /// Excludes auto-increment and DB-default columns from the INSERT statement, but keeps the
        /// explicitly listed columns so you can supply your own values for them.
        /// Combine with <see cref="WithValuePropagation"/> to read remaining DB-generated values back after insert.
        /// </summary>
        /// <param name="include">Selector returning the auto/default columns to still include in the INSERT.</param>
        public PostgresqlInsertCommandBuilder<T> ExcludeAutoFields(Expression<Func<T, object?[]>> include)
        {
            if (_ForceAllFields)
                throw new InvalidOperationException("Cannot combine ExcludeAutoFields() with WithAllFields().");
            if (_ExcludeAutoFields && _IncludedAutoFields == null)
                throw new InvalidOperationException("ExcludeAutoFields() has already been called. Use one form or the other.");
            _ExcludeAutoFields = true;
            _IncludedAutoFields = ExtractDbColumnNames(include);
            return this;
        }

        /// <summary>
        /// AOT-safe overload of <see cref="ExcludeAutoFields(Expression{Func{T, object[]}})"/> naming the kept columns
        /// by string (a property name such as <c>nameof(Row.Id)</c>, or a DB column name).
        /// </summary>
        public PostgresqlInsertCommandBuilder<T> ExcludeAutoFields(params string[] include)
        {
            if (_ForceAllFields)
                throw new InvalidOperationException("Cannot combine ExcludeAutoFields() with WithAllFields().");
            if (_ExcludeAutoFields && _IncludedAutoFields == null)
                throw new InvalidOperationException("ExcludeAutoFields() has already been called. Use one form or the other.");
            _ExcludeAutoFields = true;
            _IncludedAutoFields = global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFieldsResolver.MapDbColumnNames(include, _TableRow);
            return this;
        }

        private HashSet<string> ExtractDbColumnNames(Expression<Func<T, object?[]>> expr)
        {
            var visitor = new PostgresqlUpdateVisitor(
                expr.Parameters[0],
                _TableRow.GetDbColumnName!,
                null!);

            var memberNames = visitor.ExtractColumnNames(expr);
            var result = new HashSet<string>(StringComparer.Ordinal);
            foreach (var name in memberNames)
            {
                var dbName = _TableRow.GetDbColumnName(name);
                if (!string.IsNullOrEmpty(dbName))
                    result.Add(dbName!);
            }
            return result;
        }

        private bool ShouldIncludeColumn(string dbColName, ColumnInfo info)
        {
            if (_SelectedDbColumns != null)
                return _SelectedDbColumns.Contains(dbColName);

            if (_ExcludedDbColumns != null && _ExcludedDbColumns.Contains(dbColName))
                return false;

            if (info.IsAutoIncrement && !_ForceAllFields)
            {
                if (_IncludedAutoFields == null || !_IncludedAutoFields.Contains(dbColName))
                    return false;
            }

            if (_ExcludeAutoFields && info.HasDbDefault)
            {
                if (_IncludedAutoFields == null || !_IncludedAutoFields.Contains(dbColName))
                    return false;
            }

            return true;
        }

        public async Task<TReturning?> ExecuteReturningAsync<TReturning>(string returningColumn, global::System.Threading.CancellationToken cancellationToken = default)
        {
            if (_Connection == null)
                throw new InvalidOperationException("No DbConnection provided.");

            if (_Connection.State != System.Data.ConnectionState.Open)
                await _Connection.OpenAsync(cancellationToken);

            await using var command = _Connection.CreateCommand() as NpgsqlCommand;
            if (command == null) return default;

            if (_Transaction != null)
                command.Transaction = _Transaction as NpgsqlTransaction;

            _ColumnInfo ??= _TableRow.GetColumns();

            var columnNames = new List<string>();
            var paramNames = new List<string>();
            BuildParameters(command, columnNames, paramNames);

            command.CommandText = $@"
        INSERT INTO ""{_TableRow.GetTableName()}""
        ({string.Join(", ", columnNames)})
        VALUES
        ({string.Join(", ", paramNames)})
        RETURNING ""{returningColumn}""";

            var result = await global::Socigy.OpenSource.DB.Core.Diagnostics.DbDiagnostics.ExecuteScalarAsync(command, "INSERT", ct => command.ExecuteScalarAsync(ct), cancellationToken, _Diagnostics);
            // Route through ApplyDbValue so the RETURNING value converts the same way the row-materialization path
            // does: it returns Guid/byte[] directly (the is-T fast path), maps a timestamptz (returned as a UTC
            // DateTime) onto a DateTimeOffset target, narrows the widened unsigned types, handles enums, and only
            // uses Convert.ChangeType for genuine IConvertible widening. A raw Convert.ChangeType here threw for a
            // DateTimeOffset RETURNING column (DateTimeOffset is not IConvertible).
            return global::Socigy.OpenSource.DB.Core.CommandBuilders.ColumnInfo.ApplyDbValue<TReturning>(result);
        }

        /// <summary>
        /// Executes the configured INSERT command asynchronously against the database connection.
        /// Auto-increment columns are skipped unless <see cref="WithAllFields"/> or <see cref="WithFields"/> is used.
        /// </summary>
        /// <returns>A task whose result is <see langword="true"/> if one or more rows were inserted.</returns>
        /// <exception cref="InvalidOperationException">Thrown if a batch operation is configured or if no database connection has been provided.</exception>
        public async Task<bool> ExecuteAsync(global::System.Threading.CancellationToken cancellationToken = default)
        {
#if NET6_0_OR_GREATER
            if (_Batch != null)
                throw new InvalidOperationException("Cannot execute command when DbBatch was provided.");
#endif

            if (_Connection == null)
                throw new InvalidOperationException("No DbConnection provided.");

            if (_Connection.State != System.Data.ConnectionState.Open)
                await _Connection.OpenAsync(cancellationToken);

            await using var command = _Connection.CreateCommand() as NpgsqlCommand;
            if (command == null) return false;

            if (_Transaction != null)
                command.Transaction = _Transaction as NpgsqlTransaction;

            // Fast path: a plain default insert reuses the entity's cached static plan — no GetColumns()
            // dictionary/closures, no SQL rebuild, just bind the values.
            if (_SelectedDbColumns == null && _ExcludedDbColumns == null && _IncludedAutoFields == null
                && !_ForceAllFields && !_ExcludeAutoFields && !_PropagateValues && _ColumnInfo == null
                && _TableRow is IInsertPlanProvider __planProvider)
            {
                var __plan = __planProvider.GetInsertPlan();
                if (__plan.Columns.Length == 0) return false;
                foreach (var __col in __plan.Columns)
                    AddInsertParameter(command, __col.ParameterName, __col.GetValue(_TableRow!), __col.Type, __col.IsJson, __col.IsEncrypted);
                command.CommandText = __plan.CommandText;
                int __fastRows = await global::Socigy.OpenSource.DB.Core.Diagnostics.DbDiagnostics.ExecuteNonQueryAsync(command, "INSERT", ct => command.ExecuteNonQueryAsync(ct), cancellationToken, _Diagnostics);
                return __fastRows > 0;
            }

            _ColumnInfo ??= _TableRow.GetColumns();

            var columnNames = new List<string>();
            var paramNames = new List<string>();
            BuildParameters(command, columnNames, paramNames);

            if (columnNames.Count == 0) return false;

            if (_PropagateValues)
            {
                command.CommandText = $@"
        INSERT INTO ""{_TableRow.GetTableName()}""
        ({string.Join(", ", columnNames)})
        VALUES
        ({string.Join(", ", paramNames)})
        RETURNING *";

                await using var __instr = await global::Socigy.OpenSource.DB.Core.Diagnostics.DbDiagnostics.ExecuteReaderAsync(command, "INSERT", ct => ((System.Data.Common.DbCommand)command).ExecuteReaderAsync(ct), cancellationToken, _Diagnostics);
                var reader = __instr.Reader;
                if (await __instr.ReadAsync(cancellationToken))
                {
                    foreach (var kvp in _ColumnInfo!)
                    {
                        if (kvp.Value.SetValue == null) continue;
                        int ordinal;
                        // GetOrdinal throws only when the column is genuinely absent from RETURNING *
                        // (catch that narrowly); a real reader fault must propagate, not be swallowed,
                        // or a server-generated key would silently stay unset on the returned row.
                        try { ordinal = reader.GetOrdinal(kvp.Key); } catch (IndexOutOfRangeException) { continue; }
                        var dbVal = reader.IsDBNull(ordinal) ? null : reader.GetValue(ordinal);
                        kvp.Value.SetValue(dbVal);
                    }
                }
                return true;
            }

            command.CommandText = $@"
        INSERT INTO ""{_TableRow.GetTableName()}""
        ({string.Join(", ", columnNames)})
        VALUES
        ({string.Join(", ", paramNames)})";

            int rowsAffected = await global::Socigy.OpenSource.DB.Core.Diagnostics.DbDiagnostics.ExecuteNonQueryAsync(command, "INSERT", ct => command.ExecuteNonQueryAsync(ct), cancellationToken, _Diagnostics);
            return rowsAffected > 0;
        }

        private void BuildParameters(NpgsqlCommand command, List<string> columnNames, List<string> paramNames)
        {
            foreach (var row in _ColumnInfo!)
            {
                string colName = row.Key;
                ColumnInfo info = row.Value;

                if (!ShouldIncludeColumn(colName, info))
                    continue;

                columnNames.Add($"\"{colName}\"");

                string paramName = $"@{colName}";
                paramNames.Add(paramName);

                AddInsertParameter(command, paramName, info.Value, info.Type, info.IsJson, info.IsEncrypted);
            }
        }

        // Single place that turns a (value, type, isJson, isEncrypted) into an NpgsqlParameter — shared by the
        // dictionary path (BuildParameters) and the cached-plan fast path, so they behave identically.
        private static void AddInsertParameter(NpgsqlCommand command, string paramName, object? value, Type type, bool isJson, bool isEncrypted = false)
        {
            // Coerce only when the value is *actually* an enum at runtime. A value convertor may have already
            // turned an enum property into its DB representation (e.g. a string), in which case the declared
            // type is still the enum but the value is not, and coercing it here would corrupt or throw.
            bool valueIsEnum = value != null && value != DBNull.Value && value.GetType().IsEnum;
            if (valueIsEnum)
                value = Convert.ChangeType(value, Enum.GetUnderlyingType(value!.GetType()));

            // A DateTime column is 'timestamp without time zone'. With Kind=Utc Npgsql would infer 'timestamptz'
            // and PostgreSQL would shift the value by the session TimeZone on store. Relabel Utc as Unspecified
            // so the wall-clock is stored verbatim regardless of session TimeZone.
            if (value is DateTime __dt && __dt.Kind == DateTimeKind.Utc)
                value = DateTime.SpecifyKind(__dt, DateTimeKind.Unspecified);
            // Npgsql only writes a DateTimeOffset with offset 0 to 'timestamptz'; DateTimeOffset.Now carries the
            // local offset. Normalize to UTC (same instant) so the common case doesn't throw.
            else if (value is DateTimeOffset __dto && __dto.Offset != TimeSpan.Zero)
                value = __dto.ToUniversalTime();
            // Npgsql has no wire mapping for unsigned CLR types; widen to the signed/decimal type GetDbType targets.
            else if (value is ushort __us) value = (int)__us;
            else if (value is uint __ui) value = (long)__ui;
            else if (value is ulong __ul) value = (decimal)__ul;

            var param = new NpgsqlParameter(paramName, value ?? DBNull.Value);

            if (value == null || value == DBNull.Value || valueIsEnum)
                param.NpgsqlDbType = GetDbType(type);

            if (isJson)
                param.NpgsqlDbType = NpgsqlDbType.Jsonb;

            if (isEncrypted)
                param.NpgsqlDbType = NpgsqlDbType.Bytea;

            command.Parameters.Add(param);
        }

        public static NpgsqlDbType GetDbType(Type type)
        {
            type = Nullable.GetUnderlyingType(type) ?? type;

            if (type.IsEnum)
                type = Enum.GetUnderlyingType(type);

            return type switch
            {
                Type t when t == typeof(short) => NpgsqlDbType.Smallint,
                Type t when t == typeof(byte) => NpgsqlDbType.Smallint,
                Type t when t == typeof(sbyte) => NpgsqlDbType.Smallint,

                Type t when t == typeof(int) => NpgsqlDbType.Integer,
                Type t when t == typeof(ushort) => NpgsqlDbType.Integer,

                Type t when t == typeof(long) => NpgsqlDbType.Bigint,
                Type t when t == typeof(uint) => NpgsqlDbType.Bigint,

                Type t when t == typeof(ulong) => NpgsqlDbType.Numeric,

                Type t when t == typeof(string) => NpgsqlDbType.Text,
                Type t when t == typeof(bool) => NpgsqlDbType.Boolean,
                Type t when t == typeof(DateTime) => NpgsqlDbType.Timestamp,
                Type t when t == typeof(DateTimeOffset) => NpgsqlDbType.TimestampTz,
                Type t when t == typeof(TimeSpan) => NpgsqlDbType.Interval,
#if NET6_0_OR_GREATER
                Type t when t == typeof(DateOnly) => NpgsqlDbType.Date,
                Type t when t == typeof(TimeOnly) => NpgsqlDbType.Time,
#endif
                Type t when t == typeof(float) => NpgsqlDbType.Real,
                Type t when t == typeof(double) => NpgsqlDbType.Double,
                Type t when t == typeof(decimal) => NpgsqlDbType.Numeric,
                Type t when t == typeof(Guid) => NpgsqlDbType.Uuid,
                Type t when t == typeof(byte[]) => NpgsqlDbType.Bytea,
                Type t when t == typeof(char) => NpgsqlDbType.Char,
                _ => NpgsqlDbType.Text
            };
        }

        /// <summary>
        /// Inserts many rows efficiently as batched multi-row INSERTs — one command per chunk of up to
        /// ~65535/columns rows (PostgreSQL's per-command parameter limit) instead of a command per row.
        /// Auto-increment columns are skipped by default (the database generates them); pass
        /// <see cref="global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFields.IncludeAutoIncrement"/>
        /// to insert them too, or <see cref="global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFields.ServerDefaults"/>
        /// (optionally with <paramref name="keep"/>) to let the server fill <c>[Default]</c> columns.
        /// Returns the total rows inserted.
        /// </summary>
        public static Task<int> InsertMultipleAsync(IEnumerable<T> rows, DbConnection connection, DbTransaction? transaction = null, global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFields fields = global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFields.Default, Expression<Func<T, object?[]>>? keep = null, System.Threading.CancellationToken cancellationToken = default)
        {
            var (list, planProvider) = __PrepareInsertMultiple(rows, connection);
            if (list.Count == 0) return Task.FromResult(0);
            var cols = global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFieldsResolver.Resolve<T>(
                planProvider.GetInsertPlan(global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFieldsResolver.IncludesAutoIncrement(fields)).Columns,
                fields, keep, list[0]);
            return __InsertResolvedMultipleAsync(list, cols, connection, transaction, cancellationToken);
        }

        /// <summary>
        /// AOT-safe overload of <see cref="InsertMultipleAsync(IEnumerable{T}, DbConnection, DbTransaction, global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFields, Expression{Func{T, object[]}}, System.Threading.CancellationToken)"/>
        /// naming the kept columns by string (property name or DB column name) instead of an <c>Expression</c>
        /// selector — the expression form forces <c>Expression.NewArrayInit</c> (<c>[RequiresDynamicCode]</c>).
        /// Supplying <paramref name="keepColumns"/> implies <c>ServerDefaults</c> for the unlisted <c>[Default]</c> columns.
        /// </summary>
        public static Task<int> InsertMultipleAsync(IEnumerable<T> rows, DbConnection connection, string[] keepColumns, DbTransaction? transaction = null, global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFields fields = global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFields.Default, System.Threading.CancellationToken cancellationToken = default)
        {
            var (list, planProvider) = __PrepareInsertMultiple(rows, connection);
            if (list.Count == 0) return Task.FromResult(0);
            var cols = global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFieldsResolver.Resolve(
                planProvider.GetInsertPlan(global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertFieldsResolver.IncludesAutoIncrement(fields)).Columns,
                fields, keepColumns, list[0]);
            return __InsertResolvedMultipleAsync(list, cols, connection, transaction, cancellationToken);
        }

        private static (IList<T> list, IInsertPlanProvider planProvider) __PrepareInsertMultiple(IEnumerable<T> rows, DbConnection connection)
        {
            if (rows == null) throw new ArgumentNullException(nameof(rows));
            if (connection == null) throw new ArgumentNullException(nameof(connection));
            var list = rows as IList<T> ?? new List<T>(rows);
            if (list.Count > 0 && list[0] is not IInsertPlanProvider)
                throw new InvalidOperationException($"{typeof(T).Name} does not provide an insert plan (IInsertPlanProvider).");
            return (list, list.Count == 0 ? null! : (IInsertPlanProvider)list[0]!);
        }

        private static async Task<int> __InsertResolvedMultipleAsync(IList<T> list, global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertColumnDescriptor[] cols, DbConnection connection, DbTransaction? transaction, System.Threading.CancellationToken cancellationToken)
        {
            int colCount = cols.Length;
            if (colCount == 0) return 0;

            string tableName = ((IDbTable)list[0]!).GetTableName();

            // Column name = parameter name without the leading '@'.
            var colNames = new string[colCount];
            for (int i = 0; i < colCount; i++)
                colNames[i] = "\"" + cols[i].ParameterName.Substring(1) + "\"";
            string columnList = string.Join(", ", colNames);

            bool shouldClose = connection.State != System.Data.ConnectionState.Open;
            if (shouldClose) await connection.OpenAsync(cancellationToken);
            try
            {
                // PostgreSQL caps a command at 65535 parameters; chunk rows so each command stays under it.
                int maxRowsPerBatch = Math.Max(1, 65535 / colCount);
                int total = 0;

                for (int start = 0; start < list.Count; start += maxRowsPerBatch)
                {
                    int end = Math.Min(start + maxRowsPerBatch, list.Count);
                    await using var command = connection.CreateCommand() as NpgsqlCommand;
                    if (command == null)
                        throw new InvalidOperationException("Expected an NpgsqlConnection.");
                    if (transaction != null)
                        command.Transaction = transaction as NpgsqlTransaction;

                    var sb = new StringBuilder();
                    sb.Append("INSERT INTO \"").Append(tableName).Append("\" (").Append(columnList).Append(") VALUES ");
                    for (int r = start; r < end; r++)
                    {
                        if (r > start) sb.Append(", ");
                        sb.Append('(');
                        for (int c = 0; c < colCount; c++)
                        {
                            if (c > 0) sb.Append(", ");
                            string paramName = "@p" + r + "_" + c;
                            sb.Append(paramName);
                            AddInsertParameter(command, paramName, cols[c].GetValue(list[r]!), cols[c].Type, cols[c].IsJson, cols[c].IsEncrypted);
                        }
                        sb.Append(')');
                    }

                    command.CommandText = sb.ToString();
                    total += await global::Socigy.OpenSource.DB.Core.Diagnostics.DbDiagnostics.ExecuteNonQueryAsync(
                        command, "INSERT", ct => command.ExecuteNonQueryAsync(ct), cancellationToken);
                }
                return total;
            }
            finally
            {
                if (shouldClose) await connection.CloseAsync();
            }
        }
    }
}

#nullable disable
