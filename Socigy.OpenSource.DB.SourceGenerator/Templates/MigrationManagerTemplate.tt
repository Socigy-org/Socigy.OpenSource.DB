<#@ template language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
#pragma warning disable
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;
using Socigy.OpenSource.DB.Core.Migrations;
using Socigy.OpenSource.DB.Core;
using Socigy.OpenSource.DB.Migrations;

#nullable enable

namespace <#= BaseNamespace #>
{
    public static partial class <#= DatabaseName #>
    {
        public class MigrationManager : IMigrationManager
        {
            // Factories: only instantiate a migration when actually needed.
            // Migration SQL strings (UpSql/DownSql) can be large; this keeps them
            // out of memory until a migration is about to be applied, and GC can
            // collect them immediately after.
            // Declaration order here is irrelevant — the real apply order is resolved at class init by
            // following the PreviousId chain, which is robust to non-sortable / same-minute ids.
            private static readonly Func<ILocalMigration>[] _allFactories =
            [
    <#
                foreach (var migrationName in MigrationClassNames)
                {
    #>          static () => new <#= migrationName #>(),
    <#
                }
    #>
            ];

            // Newest-first after chain resolution, with the matching id list and id->index map.
            private static readonly Func<ILocalMigration>[] _factoriesOrderedDesc;
            private static readonly string[] _idsOrderedDesc;
            private static readonly Dictionary<string, int> _idToIndex;

            static MigrationManager()
            {
                var byId = new Dictionary<string, Func<ILocalMigration>>(_allFactories.Length);
                var chain = new List<(string, string?)>(_allFactories.Length);
                foreach (var factory in _allFactories)
                {
                    var migration = factory();
                    byId[migration.Id] = factory;
                    chain.Add((migration.Id, migration.PreviousId));
                }

                // Oldest -> newest by PreviousId chain; throws loudly on a broken/forked chain.
                var ascending = global::Socigy.OpenSource.DB.Core.Migrations.MigrationHistory.OrderByChain(chain);
                int count = ascending.Count;
                _factoriesOrderedDesc = new Func<ILocalMigration>[count];
                _idsOrderedDesc = new string[count];
                _idToIndex = new Dictionary<string, int>(count);
                for (int i = 0; i < count; i++)
                {
                    var id = ascending[count - 1 - i]; // newest first
                    _factoriesOrderedDesc[i] = byId[id];
                    _idsOrderedDesc[i] = id;
                    _idToIndex[id] = i;
                }
            }

            // IMigrationManager.LocalMigrations — materialises on demand (rarely called).
            public Dictionary<string, ILocalMigration> LocalMigrations =>
                _idToIndex.ToDictionary(kvp => kvp.Key, kvp => _factoriesOrderedDesc[kvp.Value]());

            private readonly ILogger _Logger;
            private readonly IDbConnectionFactory _ConnectionFactory;
            public MigrationManager(ILogger<MigrationManager> logger, [FromKeyedServices("<#= ServiceKey #>")] IDbConnectionFactory connectionFactory)
            {
                _Logger = logger;
                _ConnectionFactory = connectionFactory;
            }

            public Task EnsureLatestVersion()
            {
                if (_idsOrderedDesc.Length == 0) return Task.CompletedTask;
                if (!_idToIndex.TryGetValue(_idsOrderedDesc[0], out int idx))
                    throw new InvalidOperationException("Latest migration not found in index.");
                return EnsureMigration(_factoriesOrderedDesc[idx]());
            }

            public Task EnsureMigration(string migrationId)
            {
                if (!_idToIndex.TryGetValue(migrationId, out int idx))
                    throw new MissingMemberException($"Missing local migration with ID {migrationId}");
                return EnsureMigration(_factoriesOrderedDesc[idx]());
            }

            public async Task EnsureMigration(ILocalMigration migration)
            {
                await _ConnectionFactory.EnsureDbExists();

                if (!_idToIndex.TryGetValue(migration.Id, out int targetMigrationIndex))
                    throw new InvalidDataException($"Target migration {migration.Id} not found locally.");

                using var connection = _ConnectionFactory.Create();
                await connection.OpenAsync();

                // Serialize migration apply across every process/replica. Each replica calls
                // EnsureLatest{Db}Migration() on startup; without this lock they race the same CREATE TABLE /
                // DDL and crash with 42P07 / 42701 / 23505, or half-apply schema. pg_advisory_lock is
                // session-scoped on this connection and auto-releases if the process dies, so a crashed
                // migrator can't deadlock the fleet. ReadAppliedSet (below, under the lock) makes a waiter
                // that acquires the lock after the winner skip everything the winner already applied.
                static long __AdvisoryKey(string s)
                {
                    unchecked
                    {
                        // Deterministic FNV-1a 64-bit. string.GetHashCode is randomized per-process, so it
                        // would give each replica a different key and defeat the lock.
                        ulong h = 1469598103934665603UL;
                        foreach (char c in s) { h ^= c; h *= 1099511628211UL; }
                        return (long)h;
                    }
                }
                long __migrationLockKey = __AdvisoryKey("socigy.migrations:" + "<#= ServiceKey #>");
                using (var __lockCmd = connection.CreateCommand())
                {
                    __lockCmd.CommandText = "SELECT pg_advisory_lock(" + __migrationLockKey.ToString(System.Globalization.CultureInfo.InvariantCulture) + ")";
                    await __lockCmd.ExecuteNonQueryAsync();
                }
                try
                {
                // Read the current version UNDER the advisory lock. Doing it before the lock let the
                // source==target short-circuit (and the apply/rollback direction) race a concurrent apply/rollback
                // on another replica: this process could read "already at target" and return while another replica
                // was mid-rollback, leaving the schema behind with no self-correction. The cost is that an
                // already-current startup now briefly takes the lock too — negligible, and correct.
                var dbVersion = await GetCurrentMigrationVersion();
                int sourceMigrationIndex;
                if (dbVersion == null)
                    sourceMigrationIndex = _idsOrderedDesc.Length;
                else if (!_idToIndex.TryGetValue(dbVersion.HumanId, out sourceMigrationIndex))
                    throw new InvalidDataException($"Unable to find local migration with ID {dbVersion.HumanId} that is in the Database. Aborting!");

                if (sourceMigrationIndex == targetMigrationIndex)
                {
                    _Logger.LogInformation($"<#= DatabaseName #> is already at version: {migration.Id}");
                    return;
                }

                if (sourceMigrationIndex > targetMigrationIndex)
                {
                    // Defensive: never re-run UP DDL for a migration that is currently applied,
                    // even if version resolution above returned null for some reason. The set is
                    // rollback-aware (a DOWN nets the migration back out), so an UP -> DOWN -> UP
                    // is correctly re-applied rather than skipped.
                    var applied = await ReadAppliedSet();
                    for (int i = sourceMigrationIndex - 1; i >= targetMigrationIndex; i--)
                    {
                        // Instantiate only for the duration of this loop body
                        var migToApply = _factoriesOrderedDesc[i]();
                        if (applied.Contains(migToApply.Id))
                        {
                            _Logger.LogInformation($"Skipping already-applied UP migration: {migToApply.Id}");
                            continue;
                        }
                        _Logger.LogInformation($"Applying UP migration: {migToApply.Id} - {migToApply.GetType().Name}");

                        // The schema change and its version row commit together or roll back together.
                        await global::Socigy.OpenSource.DB.Core.Migrations.MigrationExecutor.ApplyAtomicAsync(
                            connection,
                            migToApply.UpSql,
                            tx => <#= DatabaseName #>.Migration.InsertAsync(new <#= DatabaseName #>.Migration
                            {
                                HumanId = migToApply.Id,
                                AppliedAt = DateTime.UtcNow,
                                ExecutedBy = $"{Environment.UserName} - {Environment.MachineName}",
                                IsRollback = false
                            }, connection, tx));
                        // migToApply goes out of scope here — SQL strings are GC-eligible
                    }
                }
                else
                {
                    // Mirror the UP guard: only roll back migrations that are CURRENTLY applied. sourceMigrationIndex
                    // was computed before the advisory lock, so a concurrent (or already-completed) rollback could
                    // otherwise re-run DownSql for a migration that is no longer applied, failing on the missing
                    // object or recording a duplicate rollback row. The set is rollback-aware.
                    var applied = await ReadAppliedSet();
                    for (int i = sourceMigrationIndex; i < targetMigrationIndex; i++)
                    {
                        var migToApply = _factoriesOrderedDesc[i]();
                        if (!applied.Contains(migToApply.Id))
                        {
                            _Logger.LogInformation($"Skipping already-rolled-back DOWN migration: {migToApply.Id}");
                            continue;
                        }
                        _Logger.LogInformation($"Applying DOWN migration: {migToApply.Id} - {migToApply.GetType().Name}");

                        // The schema change and its version row commit together or roll back together.
                        await global::Socigy.OpenSource.DB.Core.Migrations.MigrationExecutor.ApplyAtomicAsync(
                            connection,
                            migToApply.DownSql,
                            tx => <#= DatabaseName #>.Migration.InsertAsync(new <#= DatabaseName #>.Migration
                            {
                                HumanId = migToApply.Id,
                                AppliedAt = DateTime.UtcNow,
                                ExecutedBy = $"{Environment.UserName} - {Environment.MachineName}",
                                IsRollback = true
                            }, connection, tx));
                    }
                }
                }
                finally
                {
                    using var __unlockCmd = connection.CreateCommand();
                    __unlockCmd.CommandText = "SELECT pg_advisory_unlock(" + __migrationLockKey.ToString(System.Globalization.CultureInfo.InvariantCulture) + ")";
                    await __unlockCmd.ExecuteNonQueryAsync();
                }
            }

            public async Task<ILocalMigration?> GetCurrentLocalMigrationVersion()
            {
                var latestVersion = await GetCurrentMigrationVersion();
                if (latestVersion == null || !_idToIndex.TryGetValue(latestVersion.HumanId, out int idx))
                    return null;
                return _factoriesOrderedDesc[idx]();
            }

            public async Task<IMigration?> GetCurrentMigrationVersion()
            {
                try
                {
                    using var connection = _ConnectionFactory.Create();
                    if (connection.State != System.Data.ConnectionState.Open)
                        await connection.OpenAsync();

                    // On first run the migrations table doesn't exist yet. Probe with to_regclass,
                    // wrapped in "IS NOT NULL" so Npgsql materialises a boolean: reading the raw
                    // regclass value as object throws InvalidCastException once the table exists,
                    // which previously got swallowed below and re-ran every UP migration on restart.
                    using (var probe = connection.CreateCommand())
                    {
                        probe.CommandText = "SELECT to_regclass('\"" + <#= DatabaseName #>.Migration.TableName + "\"') IS NOT NULL";
                        var exists = await probe.ExecuteScalarAsync();
                        if (!(exists is bool b && b))
                            return null;
                    }

                    // Read the full history and resolve the current version accounting for rollbacks: a DOWN
                    // migration records an IsRollback row, so simply taking the latest row by timestamp would
                    // report a rolled-back migration as still current.
                    var rows = new System.Collections.Generic.List<<#= DatabaseName #>.Migration>();
                    await foreach (var row in <#= DatabaseName #>.Migration.Query().WithConnection(connection).ExecuteAsync())
                        rows.Add(row);

                    var records = new System.Collections.Generic.List<(long, string, System.DateTime, bool)>(rows.Count);
                    foreach (var row in rows)
                        records.Add((row.Id, row.HumanId, row.AppliedAt, row.IsRollback));

                    var currentId = global::Socigy.OpenSource.DB.Core.Migrations.MigrationHistory.ResolveCurrentVersion(records);
                    if (currentId == null)
                        return null;

                    // Pick the most recently applied row for that id by the monotonic Id (true apply order), not AppliedAt.
                    <#= DatabaseName #>.Migration? current = null;
                    foreach (var row in rows)
                        if (row.HumanId == currentId && !row.IsRollback && (current == null || row.Id >= current.Id))
                            current = row;
                    return current;
                }
                catch (Exception ex)
                {
                    // Never swallow a read failure into null: that path is read as "nothing applied"
                    // by EnsureMigration and triggers a destructive re-apply of already-applied DDL.
                    _Logger.LogError(ex,
                        "Failed to read current migration version from {Table}. Refusing to treat this as an empty database.",
                        <#= DatabaseName #>.Migration.TableName);
                    throw;
                }
            }

            // Reads the rollback-aware set of currently-applied migration ids using a plain command
            // over only the columns we need, deliberately bypassing the row-materialisation query path
            // so this guard stays usable even if that path regresses. Empty set means table absent.
            private async Task<System.Collections.Generic.HashSet<string>> ReadAppliedSet()
            {
                using var connection = _ConnectionFactory.Create();
                if (connection.State != System.Data.ConnectionState.Open)
                    await connection.OpenAsync();

                using (var probe = connection.CreateCommand())
                {
                    probe.CommandText = "SELECT to_regclass('\"" + <#= DatabaseName #>.Migration.TableName + "\"') IS NOT NULL";
                    var exists = await probe.ExecuteScalarAsync();
                    if (!(exists is bool b && b))
                        return new System.Collections.Generic.HashSet<string>();
                }

                var records = new System.Collections.Generic.List<(long, string, System.DateTime, bool)>();
                using (var cmd = connection.CreateCommand())
                {
                    cmd.CommandText =
                        "SELECT \"" + <#= DatabaseName #>.Migration.IdColumnName + "\", \"" +
                        <#= DatabaseName #>.Migration.HumanIdColumnName + "\", \"" +
                        <#= DatabaseName #>.Migration.AppliedAtColumnName + "\", \"" +
                        <#= DatabaseName #>.Migration.IsRollbackColumnName + "\" FROM \"" +
                        <#= DatabaseName #>.Migration.TableName + "\"";

                    await using var instr = await global::Socigy.OpenSource.DB.Core.Diagnostics.DbDiagnostics.ExecuteReaderAsync(
                        cmd, "SELECT", ct => cmd.ExecuteReaderAsync(ct));
                    while (await instr.ReadAsync())
                        records.Add((instr.Reader.GetInt64(0), instr.Reader.GetString(1), instr.Reader.GetDateTime(2), instr.Reader.GetBoolean(3)));
                }

                return global::Socigy.OpenSource.DB.Core.Migrations.MigrationHistory.ResolveAppliedSet(records);
            }
        }
    }
}

#nullable disable
<#+
    public string DatabaseName { get; set; }
    // Raw databaseName: the DI keyed-service key the MigrationManager resolves its connection factory under
    // (kept separate from DatabaseName, the C# type-name base).
    public string ServiceKey { get; set; }
    public string BaseNamespace { get; set; }
    public IList<string> MigrationClassNames { get; set; } = [];
#>
