<#@ template language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
#pragma warning disable
using Socigy.OpenSource.DB.Core.Interfaces;
using System.Collections.Generic;
using Socigy.OpenSource.DB.Core.CommandBuilders;

#nullable enable

namespace <#= Namespace #>
{

    <#= CustomPreClass #>
    public partial class <#= ClassName #> : IDbTable, IInsertPlanProvider, IOrdinalReadable
    {
        protected Dictionary<string, object?> _CustomValues { get; set; }
        public object? GetCustomValue(string key)
        {
            if (_CustomValues == null)
                return null;

            return _CustomValues.ContainsKey(key) ? _CustomValues[key] : null;
        }
        public T? GetCustomValue<T>(string key)
        {
            if (_CustomValues == null)
                return default(T);

            return _CustomValues.ContainsKey(key) ? (T?)_CustomValues[key] : default;
        }

        /// <summary>Stores a value for a custom (undeclared) column — used by DynamicTable&lt;T&gt; auto-mapping.</summary>
        public void SetCustomValue(string key, object? value)
        {
            _CustomValues ??= new Dictionary<string, object?>();
            _CustomValues[key] = value;
        }

        /// <summary>Reads a captured custom (undeclared) column value, converting if needed; false when absent.</summary>
        public bool TryGetCustomValue<TValue>(string key, out TValue? value)
        {
            if (_CustomValues != null && _CustomValues.TryGetValue(key, out var __raw))
            {
                if (__raw == null || __raw is System.DBNull) { value = default; return true; }
                if (__raw is TValue __typed) { value = __typed; return true; }
                try
                {
                    // Route through the width-tolerant converter (not Convert.ChangeType) so a custom column reads
                    // back like a declared one: a timestamptz comes back as a DateTime that maps onto a DateTimeOffset
                    // target (Convert.ChangeType throws for DateTimeOffset — it is not IConvertible), and enum/byte/
                    // unsigned widening is handled too.
                    value = global::Socigy.OpenSource.DB.Core.CommandBuilders.ColumnInfo.ApplyDbValue<TValue>(__raw);
                    return true;
                }
                catch { value = default; return false; }
            }
            value = default;
            return false;
        }

        public const string TableName = "<#= TableName #>";
        public string GetTableName() => TableName;

        public static string? GetColumnDbName(string column)
        {
            return column switch
            {
<#
            foreach(var col in Columns)
            {
                if (col.IsEncrypted)
                {
#>
                "<#= col.Name #>" => throw new global::System.NotSupportedException("Column '<#= col.Name #>' is [Encrypted] and cannot be used in a WHERE / ORDER BY / SELECT-projection / LIKE clause — encryption is non-deterministic. Filter by a non-encrypted key instead."),
<#
                }
                else
                {
#>
                "<#= col.Name #>" => <#= col.Name #>ColumnName,
<#
                }
            }
        #>
                _ => null
            };
        }

        string? IDbTable.GetDbColumnName(string memberName) => GetColumnDbName(memberName);

        // Maps a property name to a delegate that applies its [ValueConvertor].ConvertToDbValue, or null for a
        // non-convertor column. The WHERE visitor uses this to bind the CONVERTED comparison value (the column
        // stores the converted form) instead of the raw CLR value, which would match no rows. Only emitted for
        // convertor columns; the static lambdas are cached by the compiler (no per-call allocation).
        public static System.Func<object?, object?>? GetColumnConvertor(string column)
        {
            return column switch
            {
<#
            foreach(var col in Columns)
            {
                if (!col.IsJsonColumn && !string.IsNullOrEmpty(col.Converter))
                {
#>
                "<#= col.Name #>" => static __v => new <#= col.Converter #>().ConvertToDbValue((<#= col.Type #>)__v),
<#
                }
            }
#>
                _ => null
            };
        }

        public Dictionary<string, ColumnInfo> GetColumns()
        {
            return new Dictionary<string, ColumnInfo>()
            {
<#
                foreach(var col in Columns)
                {
                    bool isTypedJson = col.IsJsonColumn && !string.IsNullOrEmpty(col.JsonContextType);
                    bool hasConvertor = !col.IsJsonColumn && !string.IsNullOrEmpty(col.Converter);
                    string encType = col.Type.Replace("?", "");
                    string typeExpr = col.IsEncrypted ? "byte[]" : (col.IsJsonColumn ? "string " : col.Type.Replace("?", " "));
                    string valueExpr = col.IsEncrypted
                        ? "global::Socigy.OpenSource.DB.Core.Encryption.FieldCrypto.Encrypt((object?)" + col.Name + ", typeof(" + encType + "), TableName + \":\" + " + col.Name + "ColumnName" + ProfileArg(col) + ")"
                        : isTypedJson ? col.Name + " == null ? null : global::System.Text.Json.JsonSerializer.Serialize(" + col.Name + ", " + col.JsonContextType + ".Default.Options)"
                        : hasConvertor ? "new " + col.Converter + "().ConvertToDbValue(" + col.Name + ")"
                        : col.Name;
                    string setExpr = col.IsEncrypted
                        ? (col.EncryptAutoDecrypt
                            ? "v => " + col.Name + " = (" + col.Type + ")(global::Socigy.OpenSource.DB.Core.Encryption.FieldCrypto.Decrypt(v, typeof(" + encType + "), TableName + \":\" + " + col.Name + "ColumnName" + ProfileArg(col) + ") ?? default(" + col.Type + "))"
                            : "v => { " + col.Name + "RawEncrypted = v as byte[]; _" + col.Name + "Decrypted = false; }")
                        : isTypedJson ? "v => " + col.Name + " = v == null || v is DBNull ? null : global::System.Text.Json.JsonSerializer.Deserialize<" + col.Type.TrimEnd('?') + ">(v?.ToString() ?? \"\", " + col.JsonContextType + ".Default.Options)"
                        : hasConvertor ? "v => " + col.Name + " = (" + col.Type + ")(new " + col.Converter + "().ConvertFromDbValue(v))"
                        : "v => " + col.Name + " = ColumnInfo.ApplyDbValue<" + col.Type + ">(v)";
#>              {
                    <#= col.Name #>ColumnName,
                    new ColumnInfo()
                    {
                        Type = typeof(<#= typeExpr #>),
                        Value = <#= valueExpr #>,
                        IsJson = <#= col.IsJsonColumn ? "true" : "false" #>,
                        IsEncrypted = <#= col.IsEncrypted ? "true" : "false" #>,
                        <#= ProfileAssign(col) #>
                        IsPrimaryKey = <#= col.IsPrimaryKey ? "true" : "false" #>,
                        IsAutoIncrement = <#= col.IsAutoIncrement ? "true" : "false" #>,
                        HasDbDefault = <#= col.HasDbDefault ? "true" : "false" #>,
                        SetValue = <#= setExpr #>
                    }
                },
<#
                }
#>
            };
        }

        private static global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertPlan? __InsertPlan;
        private static global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertPlan? __InsertPlanAll;
        /// <summary>Cached plan for the default INSERT (all columns except auto-increment), reused per call.</summary>
        public global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertPlan GetInsertPlan() => GetInsertPlan(false);
        /// <summary>Cached INSERT plan; pass <c>true</c> to also include auto-increment columns (supply your own values).</summary>
        public global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertPlan GetInsertPlan(bool includeAutoIncrement)
        {
            if (includeAutoIncrement)
                return __InsertPlanAll ??= new global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertPlan(
                    "INSERT INTO \"<#= TableName #>\" (<#= InsertColList(Columns) #>) VALUES (<#= InsertParamList(Columns) #>)",
                    new global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertColumnDescriptor[]
                    {
<# EmitInsertDescriptors(Columns); #>
                    });
            return __InsertPlan ??= new global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertPlan(
                "INSERT INTO \"<#= TableName #>\" (<#= InsertColList(Columns.Where(c => !c.IsAutoIncrement)) #>) VALUES (<#= InsertParamList(Columns.Where(c => !c.IsAutoIncrement)) #>)",
                new global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertColumnDescriptor[]
                {
<# EmitInsertDescriptors(Columns.Where(c => !c.IsAutoIncrement)); #>
                });
        }

        public Dictionary<string, ColumnInfo> GetPrimaryColumns()
        {
            return new Dictionary<string, ColumnInfo>()
            {
<#
             foreach(var col in Columns.Where(x => x.IsPrimaryKey))
             {
                 // The PK feeds the UPDATE/DELETE WHERE clause, which compares against the DB column. If the column
                 // has a value convertor, the stored value is the convertor's output, so the WHERE must bind that
                 // same converted value (GetColumns does this for the SET clause) — otherwise the WHERE compares the
                 // raw CLR value and matches no rows. (Encrypted/typed-json PKs are out of scope: non-deterministic
                 // ciphertext can never match a WHERE.)
                 bool pkHasConvertor = !col.IsJsonColumn && !string.IsNullOrEmpty(col.Converter);
                 string pkValueExpr = pkHasConvertor
                     ? "new " + col.Converter + "().ConvertToDbValue(" + col.Name + ")"
                     : col.Name;
                 string pkSetExpr = pkHasConvertor
                     ? "v => " + col.Name + " = (" + col.Type + ")(new " + col.Converter + "().ConvertFromDbValue(v))"
                     : "v => " + col.Name + " = ColumnInfo.ApplyDbValue<" + col.Type + ">(v)";
#>              {
                    <#= col.Name #>ColumnName,
                    new ColumnInfo()
                    {
                        Type = typeof(<#= col.Type.Replace("?", " ") #>),
                        Value = <#= pkValueExpr #>,
                        IsPrimaryKey = true,
                        IsAutoIncrement = <#= col.IsAutoIncrement ? "true" : "false" #>,
                        HasDbDefault = <#= col.HasDbDefault ? "true" : "false" #>,
                        SetValue = <#= pkSetExpr #>
                    }
                },
<#
                }
#>
            };
        }

        public (string Name, ColumnInfo Info)? GetColumn(string name)
        {
            switch(name)
            {
<#
               foreach (var col in Columns)
               {
                   bool isTypedJson = col.IsJsonColumn && !string.IsNullOrEmpty(col.JsonContextType);
                   bool hasConvertor = !col.IsJsonColumn && !string.IsNullOrEmpty(col.Converter);
                   string encType = col.Type.Replace("?", "");
                   string typeExpr = col.IsEncrypted ? "byte[]" : (col.IsJsonColumn ? "string " : col.Type.Replace("?", " "));
                   string valueExpr = col.IsEncrypted
                       ? "global::Socigy.OpenSource.DB.Core.Encryption.FieldCrypto.Encrypt((object?)" + col.Name + ", typeof(" + encType + "), TableName + \":\" + " + col.Name + "ColumnName" + ProfileArg(col) + ")"
                       : isTypedJson ? col.Name + " == null ? null : global::System.Text.Json.JsonSerializer.Serialize(" + col.Name + ", " + col.JsonContextType + ".Default.Options)"
                       : hasConvertor ? "new " + col.Converter + "().ConvertToDbValue(" + col.Name + ")"
                       : col.Name;
                   string setExpr = col.IsEncrypted
                       ? (col.EncryptAutoDecrypt
                           ? "v => " + col.Name + " = (" + col.Type + ")(global::Socigy.OpenSource.DB.Core.Encryption.FieldCrypto.Decrypt(v, typeof(" + encType + "), TableName + \":\" + " + col.Name + "ColumnName" + ProfileArg(col) + ") ?? default(" + col.Type + "))"
                           : "v => { " + col.Name + "RawEncrypted = v as byte[]; _" + col.Name + "Decrypted = false; }")
                       : isTypedJson ? "v => " + col.Name + " = v == null || v is DBNull ? null : global::System.Text.Json.JsonSerializer.Deserialize<" + col.Type.TrimEnd('?') + ">(v?.ToString() ?? \"\", " + col.JsonContextType + ".Default.Options)"
                       : hasConvertor ? "v => " + col.Name + " = (" + col.Type + ")(new " + col.Converter + "().ConvertFromDbValue(v))"
                       : "v => " + col.Name + " = ColumnInfo.ApplyDbValue<" + col.Type + ">(v)";
#>
                case <#= col.Name #>ColumnName:
                    return (
                        <#= col.Name #>ColumnName,
                        new ColumnInfo()
                        {
                            Type = typeof(<#= typeExpr #>),
                            Value = <#= valueExpr #>,
                            IsJson = <#= col.IsJsonColumn ? "true" : "false" #>,
                            IsEncrypted = <#= col.IsEncrypted ? "true" : "false" #>,
                            <#= ProfileAssign(col) #>
                            IsPrimaryKey = <#= col.IsPrimaryKey ? "true" : "false" #>,
                            IsAutoIncrement = <#= col.IsAutoIncrement ? "true" : "false" #>,
                            HasDbDefault = <#= col.HasDbDefault ? "true" : "false" #>,
                            SetValue = <#= setExpr #>
                        }
                    );
<#
               }
#>
            }

            return null;
        }
<#
        foreach(var col in Columns)
        {
        #>
        public const string <#= col.Name #>ColumnName = "<#= col.DatabaseName #>";
<#
        }
        #>
    }
    <#= CustomPostClass #>
}

#nullable disable

<#+
    public string ClassName { get; set; }
    public string TableName { get; set; }
    public string Namespace { get; set; }
    public List<ColumnInfo> Columns { get; set; }

    public string CustomPreClass { get; set; } = "";
    public string CustomPostClass { get; set; } = "";

    public class ColumnInfo
    {
        public string Name { get; set; }
        public string Type { get; set; }
        public string DatabaseName { get; set; }
        public bool IsPrimaryKey { get; set; }
        public bool IsAutoIncrement { get; set; }
        public bool HasDbDefault { get; set; }
        // The [Default("expr")] value (a DbDefaults token or raw SQL), or null for a naked [Default]. Emitted as a
        // DEFAULT clause in the baked CREATE TABLE so a [TableType] InstantiateAsync schema matches the migration.
        public string DefaultValueSql { get; set; }
        public string SequenceName { get; set; }
        public bool IsJsonColumn { get; set; }
        public string JsonContextType { get; set; }
        public string Converter { get; set; }
        public bool IsEncrypted { get; set; }
        public bool EncryptAutoDecrypt { get; set; } = true;
        public string EncryptionProfile { get; set; }
        // For an enum column, the C# name of its underlying integral type (e.g. "int"); null otherwise. Used so a
        // baked CREATE TABLE emits the integral SQL type the insert path binds, not "text".
        public string EnumUnderlyingType { get; set; }
    }

    // Emits the optional 4th argument to FieldCrypto.Encrypt/Decrypt selecting a non-default encryptor profile;
    // empty for the common (default-profile) case so the generated call is unchanged.
    string ProfileArg(ColumnInfo col)
        => string.IsNullOrEmpty(col.EncryptionProfile) ? "" : ", \"" + col.EncryptionProfile.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";

    // Emits the runtime ColumnInfo.EncryptionProfile assignment line (only when a profile is set).
    string ProfileAssign(ColumnInfo col)
        => string.IsNullOrEmpty(col.EncryptionProfile) ? "" : "EncryptionProfile = \"" + col.EncryptionProfile.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\",";

    // Shared emit helpers for GetInsertPlan(bool) so the default and include-all plans stay identical.
    string InsertColList(System.Collections.Generic.IEnumerable<ColumnInfo> cols)
        => string.Join(", ", cols.Select(c => "\\\"" + c.DatabaseName + "\\\""));
    string InsertParamList(System.Collections.Generic.IEnumerable<ColumnInfo> cols)
        => string.Join(", ", cols.Select(c => "@" + c.DatabaseName));
    void EmitInsertDescriptors(System.Collections.Generic.IEnumerable<ColumnInfo> cols)
    {
        foreach (var col in cols)
        {
            bool isTypedJson = col.IsJsonColumn && !string.IsNullOrEmpty(col.JsonContextType);
            bool hasConvertor = !col.IsJsonColumn && !string.IsNullOrEmpty(col.Converter);
            string encType = col.Type.Replace("?", "");
            string typeExpr = col.IsEncrypted ? "byte[]" : (col.IsJsonColumn ? "string " : col.Type.Replace("?", " "));
            string valueExpr = col.IsEncrypted
                ? "global::Socigy.OpenSource.DB.Core.Encryption.FieldCrypto.Encrypt((object?)((" + ClassName + ")o)." + col.Name + ", typeof(" + encType + "), TableName + \":\" + " + col.Name + "ColumnName" + ProfileArg(col) + ")"
                : isTypedJson
                    ? "((" + ClassName + ")o)." + col.Name + " == null ? (object?)null : global::System.Text.Json.JsonSerializer.Serialize(((" + ClassName + ")o)." + col.Name + ", " + col.JsonContextType + ".Default.Options)"
                : hasConvertor
                    ? "new " + col.Converter + "().ConvertToDbValue(((" + ClassName + ")o)." + col.Name + ")"
                : "(object?)((" + ClassName + ")o)." + col.Name;
            WriteLine("                    new global::Socigy.OpenSource.DB.Core.CommandBuilders.InsertColumnDescriptor(\"@" + col.DatabaseName + "\", typeof(" + typeExpr + "), " + (col.IsJsonColumn ? "true" : "false") + ", o => " + valueExpr + ", " + (col.IsEncrypted ? "true" : "false") + ", " + (col.HasDbDefault ? "true" : "false") + "),");
        }
    }
#>
