<#@ template language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
#pragma warning disable
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Hosting;
using Socigy.OpenSource.DB.Core;
using Socigy.OpenSource.DB.Core.Credentials;
using System.Data.Common;
using System.Security;
<#
    foreach (var usingString in Usings)
    {
#>using <#= usingString #>;
<#
    }
#>

#nullable enable

namespace <#= BaseNamespace #>
{
    public class <#= DatabasePrefix #>ConnectionFactory : IDbConnectionFactory, IHostedLifecycleService
    {
        private readonly IConfiguration _Configuration;
        private readonly string? _ServiceKey;

        private readonly ILogger _Logger;
        private readonly string? _ConnectionString;
        // Optional: when a credential provider is registered (e.g. HashiCorp Vault), it supplies a
        // dynamically-rotated base connection string; otherwise the static config string is used.
        private readonly IDbCredentialsProvider? _Credentials;
        public PostgresqlConnectionFactory(ILogger<PostgresqlConnectionFactory> logger, IConfiguration configuration, [ServiceKey] object? key, IDbCredentialsProvider? credentials = null)
        {
            _Configuration = configuration;
            _ServiceKey = key as string;
            _Logger = logger;
            _Credentials = credentials;

            var connStrings = _Configuration.GetRequiredSection("ConnectionStrings");
            if (!string.IsNullOrEmpty(_ServiceKey))
                connStrings = connStrings.GetSection(_ServiceKey);

            var connectionString = connStrings["Default"];
            if (connectionString == null)
            {
                if (key != null)
                    logger.LogWarning($"No default connection string for database {key} was found!");
                else
                    logger.LogWarning("No default connection string was found!");

                return;
            }

            _ConnectionString = connectionString;
        }

        public async Task<bool> EnsureDbExists()
        {
            if (_ServiceKey == null)
            {
                string message = "No service key (database name) was provided to this connection factory instance. Unable to ensure that the database exist!";
                _Logger.LogCritical(message);
                throw new InvalidDataException(message);
            }

            // Prime/refresh dynamic credentials (e.g. Vault) before resolving the connection string.
            if (_Credentials != null)
            {
                _Logger.LogInformation("Refreshing rotating credentials for database {Database} via {Provider}", _ServiceKey, _Credentials.GetType().Name);
                await _Credentials.RefreshAsync(_ServiceKey, null);
            }

            var baseConnectionString = ResolveBaseConnectionString(null);
            if (baseConnectionString == null)
            {
                string message = $"Failed to ensure that the {_ServiceKey} database exists, because no ConnectionString was provided!";
                _Logger.LogCritical(message);
                throw new InvalidDataException(message);
            }

            // Connect to the default 'postgres' database to check/create the new database
            var masterConnectionBuilder = new NpgsqlConnectionStringBuilder(baseConnectionString)
            {
                Database = "postgres"
            };

            bool databaseExists = false;

            using (var connection = new NpgsqlConnection(masterConnectionBuilder.ToString()))
            {
                await connection.OpenAsync();

                using (var command = connection.CreateCommand())
                {
                    command.CommandText = "SELECT 1 FROM pg_database WHERE datname = @databaseName";
                    command.Parameters.Add(new NpgsqlParameter("databaseName", _ServiceKey));
                    
                    var result = await global::Socigy.OpenSource.DB.Core.Diagnostics.DbDiagnostics.ExecuteScalarAsync(command, "DDL", ct => command.ExecuteScalarAsync(ct));
                    databaseExists = result != null;
                }

                if (!databaseExists)
                {
                    using (var command = connection.CreateCommand())
                    {
                        command.CommandText = $"CREATE DATABASE \"{_ServiceKey}\"";
                        try
                        {
                            await global::Socigy.OpenSource.DB.Core.Diagnostics.DbDiagnostics.ExecuteNonQueryAsync(command, "DDL", ct => command.ExecuteNonQueryAsync(ct));
                        }
                        catch (global::Npgsql.PostgresException __ex) when (__ex.SqlState == "42P04" || __ex.SqlState == "23505")
                        {
                            // Another replica created the database first. CREATE DATABASE has no IF NOT EXISTS
                            // and can't run in a transaction, so a concurrent-startup race surfaces as
                            // 42P04 duplicate_database (or 23505 on the pg_database insert). Treat as success.
                            databaseExists = true;
                        }
                    }
                }
            }

            return databaseExists;
        }

        private string? GetConnectionString(string key)
        {
            var connStrings = _Configuration.GetRequiredSection("ConnectionStrings");
            if (!string.IsNullOrEmpty(_ServiceKey))
                connStrings = connStrings.GetSection(_ServiceKey);

            return connStrings[key];
        }

        // Resolves the base connection string (without Database=...): the credential provider wins when
        // present (rotating creds), then a named config key, then the default config string.
        private string? ResolveBaseConnectionString(string? connectionKey)
        {
            if (_Credentials != null)
            {
                var fromProvider = _Credentials.GetConnectionString(_ServiceKey ?? string.Empty, connectionKey);
                if (!string.IsNullOrEmpty(fromProvider))
                    return fromProvider;
            }

            if (connectionKey != null)
            {
                var named = GetConnectionString(connectionKey);
                if (!string.IsNullOrEmpty(named))
                    return named;
            }

            return _ConnectionString;
        }

        public DbConnection Create(string? connectionKey = null)
        {
            string connectionString = ResolveBaseConnectionString(connectionKey)
                ?? throw new InvalidDataException("Unable to create DbConnection without a ConnectionString. Please provide a connection string (or register an IDbCredentialsProvider) and try again!");

            // Connecting to the correct database
            connectionString = connectionString.TrimEnd().TrimEnd(';') + $";Database={_ServiceKey}";

            return new NpgsqlConnection(connectionString);
        }

        public async Task StartAsync(CancellationToken cancellationToken)
        {
            if (_ServiceKey != null && (_ConnectionString != null || _Credentials != null))
                await EnsureDbExists();
        }

        #region HostedLifeCycle
        public async Task StartedAsync(CancellationToken cancellationToken)
        {
        }
        public async Task StartingAsync(CancellationToken cancellationToken)
        {

        }
        public async Task StoppedAsync(CancellationToken cancellationToken)
        {
        }
        public async Task StoppingAsync(CancellationToken cancellationToken)
        {
        }
        public async Task StopAsync(CancellationToken cancellationToken)
        {
        }
        #endregion
    }
}

#nullable disable

<#+
    public string BaseNamespace { get; set; }

    public string DatabasePrefix { get; set; }
    public IEnumerable<string> Usings { get; set; }
    public string ConnectionClassName { get; set; }
#>