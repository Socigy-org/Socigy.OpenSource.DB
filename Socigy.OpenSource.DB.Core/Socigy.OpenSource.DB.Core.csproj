<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<IsPackable>false</IsPackable>
		<Configurations>Debug;Release;DB_Migration</Configurations>
		<!-- Enable the nullable ANNOTATION context project-wide (so `?` is valid everywhere — fixes CS8632)
		     without turning on nullable flow warnings; files keep their own `#nullable enable` blocks. -->
		<Nullable>annotations</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.8" />
	  <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.8" />
	  <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
	</ItemGroup>

</Project>
