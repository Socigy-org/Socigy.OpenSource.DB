<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;DB_Migration</Configurations>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Deliberately NOT GeneratePackageOnBuild: NuGet drops Build from the Pack target's dependencies when
		     it is set (NuGet.Build.Tasks.Pack.targets), so a plain "dotnet pack" would silently package whatever
		     stale assembly happened to be in bin/$(Configuration) instead of compiling, and would fail with an
		     obscure NU5026 on a clean tree. "dotnet pack" now builds first, like everywhere else. CI builds
		     explicitly and packs with NoBuild, so it is unaffected. -->
		<Title>Socigy DB - HashiCorp Vault</Title>
		<!-- NuGet version for this package. Defined in Directory.Build.props ($(HashiCorpPackageVersion)),
		     independently of the main package and the base $(Version). The DLL is stamped to match. -->
		<PackageVersion>$(HashiCorpPackageVersion)</PackageVersion>
		<AssemblyVersion>$(PackageVersion)</AssemblyVersion>
		<FileVersion>$(PackageVersion)</FileVersion>
		<Version>$(PackageVersion)</Version>
		<Company>Socigy s.r.o.</Company>
		<Description>Optional HashiCorp Vault / OpenBao integration for Socigy.OpenSource.DB: field encryption (KV-v2 key, Transit data-key envelope with key rotation, or Transit EaaS-direct) and rotating DB credentials (Database secrets engine).</Description>
		<PackageTags>db;postgresql;hashicorp;vault;openbao;transit;encryption;credentials;socigy</PackageTags>
		<Authors>Socigy, PatrikStohanzl</Authors>
		<Copyright>Copyright © 2024 Socigy s.r.o.</Copyright>
		<RepositoryUrl>https://github.com/Socigy-org/Socigy.OpenSource.DB</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://docs.socigy.com/database/</PackageProjectUrl>
		<PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="VaultSharp" Version="1.17.5.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Socigy.OpenSource.DB.HashiCorp.Tests" />
	</ItemGroup>

	<!-- Compile-time access to the Core abstractions (IFieldEncryptor, IDbCredentialsProvider). The Core DLL
	     is supplied to consumers by the main Socigy.OpenSource.DB package, which this package depends on once
	     a matching version is published; declared via the nuspec dependency below at pack time. -->
	<ItemGroup>
		<ProjectReference Include="..\Socigy.OpenSource.DB.Core\Socigy.OpenSource.DB.Core.csproj">
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
	</ItemGroup>
	<ItemGroup>
		<None Update="icon.png">
			<PackagePath>\</PackagePath>
			<Pack>True</Pack>
		</None>
	</ItemGroup>

	<!-- A ProjectReference to the main packable project makes NuGet emit a <dependency> on
	     Socigy.OpenSource.DB (at the same version) in this package's nuspec at pack time — without needing that
	     (possibly-unpublished) version to be restorable. The main project produces no lib output
	     (IncludeBuildOutput=false), so nothing is bundled; the Core types come from the Core ProjectReference
	     above. The main project's build assembly is empty (no source), so referencing it is harmless. -->
	<ItemGroup>
		<ProjectReference Include="..\Socigy.OpenSource.DB\Socigy.OpenSource.DB.csproj" />
	</ItemGroup>

</Project>
