<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Multi-targeted: netstandard2.0 keeps the broad surface; net8.0 carries the Npgsql dependency, which
		     ships no netstandard2.0 asset. Consumers on net8+ pick the net8.0 dependency group. -->
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<LangVersion>preview</LangVersion>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;DB_Migration</Configurations>
		<IncludeBuildOutput>false</IncludeBuildOutput>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Deliberately NOT GeneratePackageOnBuild: NuGet drops Build from the Pack target's dependencies when
		     it is set (NuGet.Build.Tasks.Pack.targets), so a plain "dotnet pack" would silently package whatever
		     stale assembly happened to be in bin/$(Configuration) instead of compiling, and would fail with an
		     obscure NU5026 on a clean tree. It also made a build of any project referencing this one re-run this
		     package's full pack. "dotnet pack" now builds first, like everywhere else; CI builds explicitly and
		     packs with NoBuild, so it is unaffected. -->
		<Title>Socigy DB</Title>
		<!-- NuGet version for this package. Defined in Directory.Build.props ($(DbPackageVersion)),
		     independently of the HashiCorp package and the base $(Version). -->
		<PackageVersion>$(DbPackageVersion)</PackageVersion>
		<Company>Socigy s.r.o.</Company>
		<Product>$(PackageTitle)</Product>
		<Description>Automated cross-DB model generation and automation nuget. Auto-generates and propagates db model across multiple DB</Description>
		<PackageTags>db;migration;automated;postgresql;source-generator</PackageTags>

		<AssemblyVersion>$(PackageVersion)</AssemblyVersion>
		<FileVersion>$(PackageVersion)</FileVersion>
		<Version>$(PackageVersion)</Version>
		<Authors>Socigy, PatrikStohanzl</Authors>
		<Copyright>Copyright © 2024 Socigy s.r.o.</Copyright>
		<RepositoryUrl>https://github.com/Socigy-org/Socigy.OpenSource.DB</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://docs.socigy.com/database/</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">True</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">True</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\docs\**" Pack="true" PackagePath="\docs" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="build\Socigy.OpenSource.DB.targets" Pack="true" PackagePath="build\Socigy.OpenSource.DB.targets" />
	</ItemGroup>

	<!-- These flow to consumers as package <dependencies>. The Core DLL is injected manually
	     (see IncludeCoreDllInPackage) with PrivateAssets=all, so Core's own package refs do NOT
	     propagate — they must be declared here on the packable project. On net6+ consumers these
	     types are provided by the shared framework; declaring them is still correct for others. -->
	<ItemGroup>
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
		<!-- Runtime dependency of the injected Core DLL; declare it here so it flows to consumers (the Core
		     ProjectReference below is PrivateAssets=all, so Core's own refs don't propagate). Ships ns2.0. -->
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.8" />
		<!-- The generated table code uses Npgsql (NpgsqlCommand/NpgsqlDbType). Npgsql 10 ships no ns2.0 asset,
		     so it's declared only for the net8.0 group; net8+ consumers get it transitively. -->
		<PackageReference Include="Npgsql" Version="10.0.3" Condition="'$(TargetFramework)' == 'net8.0'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Socigy.OpenSource.DB.Core\Socigy.OpenSource.DB.Core.csproj">
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
		<ProjectReference Include="..\Socigy.OpenSource.DB.SourceGenerator\Socigy.OpenSource.DB.SourceGenerator.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Analyzer</OutputItemType>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
	  <!-- Include (not Update) so the icon is packed at the outer cross-targeting build where pack runs and the
	       default item globs don't apply. Remove first to avoid duplicating the inner-build auto-include. -->
	  <None Remove="icon.png" />
	  <None Include="icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<Target Name="IncludeCoreDllInPackage" BeforeTargets="GenerateNuspec">
		<MSBuild Projects="..\Socigy.OpenSource.DB.Core\Socigy.OpenSource.DB.Core.csproj" Targets="GetTargetPath">
			<Output TaskParameter="TargetOutputs" ItemName="SocigyCoreDll" />
		</MSBuild>
		<!--<ItemGroup>
			<_CoreDll Include="..\Socigy.OpenSource.DB.Core\bin\$(Configuration)\netstandard2.0\Socigy.OpenSource.DB.Core.dll" />
		</ItemGroup>-->

		<Message Text="[Socigy.OpenSource.DB] Injecting Core DLL from @(SocigyCoreDll)" Importance="High" />

		<ItemGroup>
			<_PackageFiles Include="@(SocigyCoreDll)">
				<!-- Core is a single ns2.0 DLL usable by both dependency groups; hardcode the path so the single
				     GenerateNuspec pass (where $(TargetFramework) is empty under multi-targeting) is correct. -->
				<PackagePath>lib\netstandard2.0</PackagePath>
				<Visible>true</Visible>
				<BuildAction>Content</BuildAction>
			</_PackageFiles>
		</ItemGroup>
	</Target>

	<Target Name="IncludeSourceGeneratorInPackage" BeforeTargets="GenerateNuspec">
		<MSBuild Projects="..\Socigy.OpenSource.DB.SourceGenerator\Socigy.OpenSource.DB.SourceGenerator.csproj" Targets="GetTargetPath">
			<Output TaskParameter="TargetOutputs" ItemName="SocigySourceGenDll" />
		</MSBuild>

		<Message Text="[Socigy.OpenSource.DB] Injecting SourceGenerator DLL from @(SocigySourceGenDll)" Importance="High" />

		<ItemGroup>
			<_PackageFiles Include="@(SocigySourceGenDll)">
				<PackagePath>analyzers/dotnet/cs</PackagePath>
				<Visible>false</Visible>
				<BuildAction>Content</BuildAction>
			</_PackageFiles>
		</ItemGroup>
	</Target>
	
	<Target Name="PackCliTool" BeforeTargets="GenerateNuspec">
		<PropertyGroup>
			<ToolPublishDir>$(MSBuildProjectDirectory)/obj/ToolPublish/</ToolPublishDir>
			<ToolPublishDirAny>$(ToolPublishDir)any/</ToolPublishDirAny>
			<ToolPublishDirWin>$(ToolPublishDir)win/</ToolPublishDirWin>
		</PropertyGroup>

		<RemoveDir Directories="$(ToolPublishDir)" />

		<Message Text="[Socigy] Building Portable Tool..." Importance="High" />
		<MSBuild Projects="..\Socigy.OpenSource.DB.Tool\Socigy.OpenSource.DB.Tool.csproj" Targets="Publish" Properties="Configuration=Release;TargetFramework=net10.0;PublishDir=$(ToolPublishDirAny);SelfContained=false" />

		<Message Text="[Socigy] Building Windows Tool..." Importance="High" />
		<MSBuild Projects="..\Socigy.OpenSource.DB.Tool\Socigy.OpenSource.DB.Tool.csproj" Targets="Publish" Properties="Configuration=Release;TargetFramework=net10.0-windows;PublishDir=$(ToolPublishDirWin);SelfContained=false;EnableWindowsTargeting=true" />

		<ItemGroup>
			<_ToolFilesAny Include="$(ToolPublishDirAny)**/*" />
			<_ToolFilesWin Include="$(ToolPublishDirWin)**/*" />
		</ItemGroup>

		<ItemGroup>
			<_PackageFiles Include="@(_ToolFilesAny)">
				<PackagePath>tools/any/%(RecursiveDir)</PackagePath>
				<Visible>false</Visible>
				<BuildAction>Content</BuildAction>
			</_PackageFiles>

			<_PackageFiles Include="@(_ToolFilesWin)">
				<PackagePath>tools/win/%(RecursiveDir)</PackagePath>
				<Visible>false</Visible>
				<BuildAction>Content</BuildAction>
			</_PackageFiles>
		</ItemGroup>
	</Target>
</Project>
